<?xml version="1.0" encoding="utf-8"?>
<!--
  联调工具主界面：标题 + 三个页签 + 内容容器。
  页签用 TextView 手工做，不引 TabLayout，省掉主题依赖与额外样式。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F2EC"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dev_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A1917" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/dev_sub"
            android:textSize="12sp"
            android:textColor="#6E695E" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tabNet"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tab_net"
            android:textSize="14sp"
            android:textColor="@color/color_dev_tab"
            android:background="@drawable/bg_dev_tab"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabLog"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="@string/tab_log"
            android:textSize="14sp"
            android:textColor="@color/color_dev_tab"
            android:background="@drawable/bg_dev_tab"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabCard"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="@string/tab_card"
            android:textSize="14sp"
            android:textColor="@color/color_dev_tab"
            android:background="@drawable/bg_dev_tab"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp" />

</LinearLayout>
