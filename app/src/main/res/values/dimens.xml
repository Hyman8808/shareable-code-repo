<?xml version="1.0" encoding="utf-8"?>
<!--
    拇指相机 · 设计 Token：尺寸（V2.0 墨标 Inkmark）
    ============================================================
    间距：4dp 基准，垂直节奏取 8 的倍数。**布局里禁止再出现裸数字 dp 值**
        （图片高度、分割线粗细这类「物理尺寸」除外）。
    圆角 6 档（尺寸越大圆角越大，一屏最多出现 3 种）：
        · xs(6)   → 色点容器、极小标签
        · sm(10)  → **行内缩略图**、Ghost 按钮
        · md(14)  → 主次按钮、输入框、卡内嵌块、详情页图
        · lg(20)  → 白卡、详情主卡
        · xl(28)  → sheet、弹窗
        · pill    → chip、导航药丸、搜索框
      与 V1.9 的差别：主卡 16→20、行内图 12→**10**。差距被拉开一倍——
      大卡更有体积、小图更像贴纸；V1.9 的 12/16 挤在一起，等于没有层级。
    触控：任何可点元素热区 ≥ 44dp（WCAG / Material 双标准），
        视觉图标可以只画 20dp，但外层必须撑到 44dp。
-->
<resources>
    <!-- ============ 间距 ============ -->
    <dimen name="space_2">2dp</dimen>
    <dimen name="space_4">4dp</dimen>
    <dimen name="space_6">6dp</dimen>
    <dimen name="space_8">8dp</dimen>
    <dimen name="space_10">10dp</dimen>
    <dimen name="space_12">12dp</dimen>
    <dimen name="space_16">16dp</dimen>
    <dimen name="space_20">20dp</dimen>
    <dimen name="space_24">24dp</dimen>
    <dimen name="space_28">28dp</dimen>
    <dimen name="space_32">32dp</dimen>
    <dimen name="space_40">40dp</dimen>
    <dimen name="space_48">48dp</dimen>
    <dimen name="space_56">56dp</dimen>

    <!-- ============ 页面边距 ============ -->
    <dimen name="page_horizontal">20dp</dimen>
    <dimen name="page_horizontal_detail">16dp</dimen>
    <!-- 首页首屏预算：从 12dp 收到 8dp（每省 4dp = 首屏多露 4dp 卡片） -->
    <dimen name="page_top">8dp</dimen>
    <dimen name="page_top_after_inset">16dp</dimen>
    <dimen name="page_bottom">24dp</dimen>

    <!-- ============ 圆角 ============ -->
    <dimen name="radius_xs">6dp</dimen>
    <dimen name="radius_sm">10dp</dimen>
    <dimen name="radius_md">14dp</dimen>
    <dimen name="radius_lg">20dp</dimen>
    <dimen name="radius_xl">28dp</dimen>
    <dimen name="radius_pill">999dp</dimen>

    <!-- ============ 触控 / 图标 ============ -->
    <dimen name="touch_min">44dp</dimen>
    <dimen name="icon_touch">40dp</dimen>
    <dimen name="icon_sm">16dp</dimen>
    <dimen name="icon_md">20dp</dimen>
    <dimen name="icon_lg">24dp</dimen>
    <dimen name="icon_xl">28dp</dimen>

    <!-- ============ 组件 ============ -->
    <dimen name="btn_height">52dp</dimen>
    <dimen name="btn_height_md">44dp</dimen>
    <dimen name="btn_height_sm">36dp</dimen>
    <dimen name="row_height">56dp</dimen>
    <!-- 列表行（compact 密度）：64dp 缩略图 + 三行文字 = 88dp -->
    <dimen name="row_height_compact">88dp</dimen>
    <dimen name="thumb_row">64dp</dimen>
    <dimen name="card_padding">20dp</dimen>
    <dimen name="card_padding_compact">16dp</dimen>
    <dimen name="card_elevation">2dp</dimen>
    <dimen name="divider_height">1dp</dimen>

    <!-- ============ 底部导航 ============ -->
    <!-- 底部导航高度：M3 默认 80dp 太高，吃掉 16dp 列表视口。
         62–64dp 是「22dp 图标 + 11sp 文字」在不裁切前提下的下限，
         别再往下压（56dp 会裁掉 label 的下伸部）。 -->
    <dimen name="nav_bar_height">64dp</dimen>
    <dimen name="nav_indicator_w">40dp</dimen>
    <dimen name="nav_indicator_h">26dp</dimen>

    <!-- ============ 图片 ============ -->
    <dimen name="thumb_grid_height">132dp</dimen>
    <!-- 详情页图片不再用固定高度：改由 ConstraintLayout 的 4:3 比例约束决定，
         与网格卡图框同一比例（客户相机 4:3 / 16:9 / 1:1 都走这一套）。 -->

    <!-- ============ 字阶（12 阶，唯一合法来源） ============ -->
    <!-- 旧名保留：其它布局仍在引用，值已指到 V2.0 字阶 -->
    <dimen name="text_display">30sp</dimen>
    <dimen name="text_h1">22sp</dimen>
    <dimen name="text_h2">17sp</dimen>
    <dimen name="text_h3">15sp</dimen>
    <dimen name="text_body">15sp</dimen>
    <dimen name="text_body_sm">13sp</dimen>
    <dimen name="text_caption">12sp</dimen>
    <dimen name="text_micro">11sp</dimen>
    <dimen name="text_metric">30sp</dimen>
    <!-- V2.0 新增 -->
    <dimen name="text_headword_xl">34sp</dimen>
    <dimen name="text_headword_xl_cjk">30sp</dimen>
    <dimen name="text_headword">19sp</dimen>
    <dimen name="text_headword_cjk">15sp</dimen>
    <dimen name="text_phonetic">14sp</dimen>
    <dimen name="text_label">11sp</dimen>

    <!-- 选择态底栏占位：底栏内容实测 72dp（12+44+12+1dp 边线），留 88dp 才有呼吸 -->
    <dimen name="selection_bar_space">88dp</dimen>
</resources>
