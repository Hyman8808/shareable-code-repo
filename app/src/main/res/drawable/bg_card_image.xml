<?xml version="1.0" encoding="utf-8"?>
<!--
    行内缩略图底：10dp 圆角 + placeholder 填充。
    为什么是 10dp（不是 14）：列表行里图只有 64dp，配 14dp 圆角会像一颗药丸；
    圆角越小、图越像「贴纸」，与大卡 20dp 的体量差拉开层级。
    配合 ImageView 的 clipToOutline="true" 一起用，否则网络图会把圆角盖掉。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/placeholder" />
    <corners android:radius="@dimen/radius_sm" />
</shape>
