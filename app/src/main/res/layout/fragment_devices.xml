<?xml version="1.0" encoding="utf-8"?>
<!--
    设备管理 Tab
    ============================================================
    重设计要点：
    · 顶部留白 40dp → 14dp，标题统一字阶。
    · 「长按删除」从一行灰字改为紧贴列表上方的弱提示（仍然是 11sp，但不抢视线）。
    · 空状态用 drawableTop 图标 + 文案，避免再包一层容器（代码只切一个 visibility）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_horizontal"
    android:paddingEnd="@dimen/page_horizontal"
    android:paddingTop="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Text.PageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_devices" />

        <TextView
            android:id="@+id/tvDeviceCount"
            style="@style/Text.Micro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        style="@style/Text.Micro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/device_long_press" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBoundDevices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/tvBoundEmpty"
        style="@style/Text.BodySm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:drawableTop="@drawable/ic_bluetooth_48"
        android:drawablePadding="18dp"
        android:drawableTint="@color/text_disabled"
        android:gravity="center"
        android:lineSpacingExtra="5dp"
        android:text="@string/device_empty"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnAddMore"
        style="@style/Widget.ThumbCard.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="24dp"
        android:text="@string/device_add"
        android:textSize="16sp" />

</LinearLayout>
