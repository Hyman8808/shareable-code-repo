<?xml version="1.0" encoding="utf-8"?>
<!--
    收藏 Tab（只显示已收藏）
    ============================================================
    V2.0 墨标要点：
    1. 标题走统一字阶（text_h1），右侧数量用 Text.Label（小号 + 字距），
       让「收藏」是大字、数量是注脚，层级靠字号拉而不是靠加粗。
    2. 搜索框改 pill 全圆角、**无描边**（@drawable/bg_search）：
       带描边的输入框在纸底上会被读成「表单」，这里是筛选器不是表单项。
       高 44dp 对齐触控下限。
    3. 列表改 2 列卡片流：RecyclerView 左右 padding 14dp + item 自身 6dp 外边距
       = 第一列左边距 20dp，正好对齐标题的 page_horizontal；列间距 12dp。
       顶 10dp 给卡片阴影留呼吸，不然第一行阴影会被列表边缘切平。
    4. 空状态用虚线环（bg_empty_ring）而不是实心浅圆：
       虚线表示「这里还空着」，实心圆看起来像一个已经放好的东西。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/page_horizontal"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.PageTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/nav_cards" />

            <TextView
                android:id="@+id/tvCount"
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!--
                「选择」入口。高度给满 touch_min（44dp），文字只有 13sp ——
                热区靠 padding 撑，不靠字号撑：这个按钮一天点不了两次，
                但一旦做成 28dp 高，想批量修图的人会连点三次点不中。
            -->
            <TextView
                android:id="@+id/btnSelect"
                style="@style/Text.BodySm"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="@dimen/touch_min"
                android:paddingStart="16dp"
                android:text="@string/cards_select"
                android:textColor="@color/brand_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 搜索（无设备时隐藏：搜索无意义） -->
        <LinearLayout
            android:id="@+id/grpSearch"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_16">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="@color/text_tertiary" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space_10"
                android:background="@null"
                android:importantForAutofill="no"
                android:hint="@string/cards_search_placeholder"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </LinearLayout>

    <!-- 列表与空状态同层叠放：空状态才能真正的「在可视区域居中」。
         原实现把空状态排在 RecyclerView 后面，它会被 weight=1 的列表挤到屏幕最底部。 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 14dp + item 的 6dp 外边距 = 20dp，对齐标题缩进 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCards"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="@dimen/space_24" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- 空状态：虚线环 + 文案 + 引导按钮 -->
        <LinearLayout
            android:id="@+id/groupEmptyCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingTop="52dp"
            android:paddingBottom="40dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_empty_ring">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_heart_outline"
                    app:tint="@color/text_tertiary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvEmpty"
                style="@style/Text.BodySm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center"
                android:lineSpacingExtra="5dp" />

            <Button
                android:id="@+id/btnGoAdd"
                style="@style/Widget.ThumbCard.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height_sm"
                android:layout_marginTop="@dimen/space_24"
                android:minWidth="160dp"
                android:text="@string/cards_go_add"
                android:visibility="gone" />
        </LinearLayout>
        <!--
            选择态底栏：只在多选时出现，浮在列表上方。
            左列「已选 N 张」+ 额度提示，右列两个动作按钮。
            两个按钮而不是「先选风格再点开始」：少一次点击。
            「高清」与「卡通」是两种并列的结果语言，本来就该在这一步选，
            再套一层弹窗（选风格 → 确定）只会让付费动作变长。
        -->
        <LinearLayout
            android:id="@+id/barSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_selection_bar"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_horizontal"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/page_horizontal"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSelectionCount"
                    style="@style/Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="已选 3 张" />

                <TextView
                    android:id="@+id/tvSelectionQuota"
                    style="@style/Text.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    tools:text="剩 8 张" />
            </LinearLayout>

            <Button
                android:id="@+id/btnBatchHd"
                style="@style/Widget.ThumbCard.Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height_md"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/ai_style_hd"
                android:textSize="@dimen/text_body_sm" />

            <Button
                android:id="@+id/btnBatchCartoon"
                style="@style/Widget.ThumbCard.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height_md"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/cards_batch_cartoon"
                android:textSize="@dimen/text_body_sm" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
