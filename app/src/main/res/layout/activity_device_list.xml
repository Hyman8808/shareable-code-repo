<?xml version="1.0" encoding="utf-8"?>
<!--
    我的设备（独立页，从「我的 ›」或首页设备入口进入）
    与设备管理 Tab 保持完全一致的视觉语言，只多了页面标题与返回场景。
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/tvDeviceTitle"
        style="@style/Text.PageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_horizontal"
        android:layout_marginTop="16dp"
        android:text="@string/home_my_devices"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        多设备时的操作说明：点按即切换当前设备（v2.8.0）。
        只在一台以上的时候显示 —— 单设备没有「切换」这回事。
    -->
    <TextView
        android:id="@+id/tvDeviceHint"
        style="@style/Text.Micro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="@dimen/page_horizontal"
        android:text="@string/device_switch_hint"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDeviceTitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBoundDevices"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/page_horizontal"
        android:layout_marginEnd="@dimen/page_horizontal"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/btnAddMore"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDeviceHint" />

    <TextView
        android:id="@+id/tvBoundEmpty"
        style="@style/Text.BodySm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:drawableTop="@drawable/ic_bluetooth_48"
        android:drawablePadding="18dp"
        android:drawableTint="@color/text_disabled"
        android:gravity="center"
        android:text="@string/home_no_device"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rvBoundDevices"
        app:layout_constraintEnd_toEndOf="@id/rvBoundDevices"
        app:layout_constraintStart_toStartOf="@id/rvBoundDevices"
        app:layout_constraintTop_toTopOf="@id/rvBoundDevices" />

    <Button
        android:id="@+id/btnAddMore"
        style="@style/Widget.ThumbCard.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="@dimen/page_horizontal"
        android:layout_marginEnd="@dimen/page_horizontal"
        android:layout_marginBottom="24dp"
        android:text="@string/home_add_device"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
