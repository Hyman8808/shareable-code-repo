<?xml version="1.0" encoding="utf-8"?>
<!--
    购买张数（弹窗）
    ============================================================
    1. 顶部一句「你还有 N 张」比任何营销文案都有用——用户是来补充额度的，
       不是来看促销的。
    2. 档位按「用量场景」写一句人话（先试几个词 / 一学期 / 一学年），
       只写数字用户无法判断该买哪一档。
    3. 价格位留白：真实价格与支付通道未接入，调试期不编价格。
       确认按钮明确写「模拟、不扣款」，避免被误当成真实购买。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="22dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/tvPurchaseTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/ai_buy_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_h1" />

    <TextView
        android:id="@+id/tvPurchaseSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_body_sm"
        tools:text="总共还能生成 2 张；购买的张数可以用于高清修复或卡通化" />

    <LinearLayout
        android:id="@+id/groupTiers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/ai_buy_debug_note"
        android:textColor="@color/warning"
        android:textSize="@dimen/text_caption" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPurchaseConfirm"
        style="@style/Widget.ThumbCard.Button.Primary"
        android:layout_width="match_parent"
        android:layout_marginTop="14dp"
        android:text="@string/ai_buy_confirm" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPurchaseCancel"
        style="@style/Widget.ThumbCard.Button.Ghost"
        android:layout_width="match_parent"
        android:layout_marginTop="2dp"
        android:text="@string/common_cancel" />

</LinearLayout>
