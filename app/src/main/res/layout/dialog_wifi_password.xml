<?xml version="1.0" encoding="utf-8"?>
<!-- 选中加密 WiFi 后的密码输入框。标题由代码设为 SSID，这里只放输入区。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <EditText
        android:id="@+id/etPwd"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input"
        android:hint="@string/wifi_pwd_hint"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:maxLength="64"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_disabled"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/tvPwdError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/wifi_pwd_empty"
        android:textColor="@color/warning"
        android:textSize="@dimen/text_body_sm"
        android:visibility="gone" />

</LinearLayout>
