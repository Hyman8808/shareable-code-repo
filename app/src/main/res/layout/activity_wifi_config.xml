<?xml version="1.0" encoding="utf-8"?>
<!--
    Wi-Fi 配网页（配网第 2 步 · V1.2 列表式）
    ============================================================
    交互变化（相对上一版）：
    · 原来由用户手输 SSID，现在改成「设备扫 → 列表点选」，因此
      整页没有主按钮：进页即连设备、连上即取列表，用户唯一动作是点一个热点。
    · 顶部「仅支持 2.4G」提示条保留，但含义从「你要自己判断」变成
      「设备已经帮你过滤掉了 5G」，所以文案也一并改掉。
    · 列表为空/加载中都在同一个区域内说明，不再弹 Toast，避免列表区一片空白。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvWifiTitle"
        style="@style/Text.PageTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/page_horizontal"
        android:text="@string/wifi_title" />

    <TextView
        android:id="@+id/tvWifiHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/page_horizontal"
        android:background="@drawable/bg_hint_warning"
        android:lineSpacingExtra="3dp"
        android:padding="12dp"
        android:text="@string/wifi_hint"
        android:textColor="@color/warning"
        android:textSize="@dimen/text_body_sm" />

    <LinearLayout
        android:id="@+id/boxList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/page_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/page_horizontal"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <TextView
                style="@style/Text.Micro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/wifi_ap_title" />

            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/wifi_refresh"
                android:src="@drawable/ic_refresh"
                android:tint="@color/text_secondary" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tvListState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:padding="24dp"
            android:text="@string/wifi_scan_loading"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body_sm"
            android:visibility="gone" />

        <!--
            兜底入口：列表为空或扫描超时才显示。
            未升级的样机固件（V1.0 基线，不实现 0x88/0x89）靠它完成配网，
            否则页面只剩「刷新」，设备永远配不上。
        -->
        <Button
            android:id="@+id/btnManualSsid"
            style="@style/Widget.ThumbCard.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="14dp"
            android:text="@string/wifi_manual_entry"
            android:textSize="@dimen/text_body_sm"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/svLog"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginStart="@dimen/page_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="@dimen/page_horizontal"
        android:background="@drawable/bg_card"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </ScrollView>

    <Button
        android:id="@+id/btnCopyLog"
        style="@style/Widget.ThumbCard.Button.Outline"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="@dimen/page_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="@dimen/page_horizontal"
        android:layout_marginBottom="16dp"
        android:text="@string/wifi_copy_log"
        android:textSize="@dimen/text_body_sm"
        android:visibility="gone" />

</LinearLayout>
