<?xml version="1.0" encoding="utf-8"?>
<!--
    诊断报告（研发工具页）
    ============================================================
    这一页是给研发/客服看的，字号和留白保持偏紧凑（monospace 12sp 能一屏看更多行），
    只做三件事：
    · 标题统一到全 App 字阶
    · 顶部留白收紧（原来 padding 16 + marginTop 24 = 顶部 40dp 空白）
    · 底部三个按钮统一圆角与高度，主操作（复制）保持实心
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <TextView
        style="@style/Text.PageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/diag_title" />

    <TextView
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/diag_sub" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:padding="12dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tvDiagContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </ScrollView>

    <!-- 云端连通性自检 -->
    <Button
        android:id="@+id/btnCloudCheck"
        style="@style/Widget.ThumbCard.Button.Outline"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:text="@string/diag_cloud_check"
        android:textSize="@dimen/text_body_sm" />

    <TextView
        android:id="@+id/tvCloudCheckResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:fontFamily="monospace"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textIsSelectable="true"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.ThumbCard.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="@string/diag_back"
            android:textSize="@dimen/text_body_sm" />

        <Button
            android:id="@+id/btnClear"
            style="@style/Widget.ThumbCard.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/diag_clear"
            android:textSize="@dimen/text_body_sm" />

        <Button
            android:id="@+id/btnCopy"
            style="@style/Widget.ThumbCard.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/diag_copy"
            android:textSize="@dimen/text_body_sm" />
    </LinearLayout>

</LinearLayout>
