<?xml version="1.0" encoding="utf-8"?>
<!-- 界面语言选择弹窗：**容器 + 动态行**，不再写死 4 行。
     为什么不用 setSingleChoiceItems + setMessage：部分机型上「说明文字 + 单选列表」
     同屏渲染时列表被压到折叠区里，用户只看到说明、看不到选项（2026-10-21 真机反馈）。

     本版界面语言已扩到 10 档（简/繁/英/日/韩/西/法/德/俄/阿），10 × 62dp 会超出小屏，
     因此列表放进固定高度的 ScrollView；行模板见 item_ui_language.xml，
     顺序与文案统一由 UiLanguage.ALL 决定，本文件不再出现任何语言名。

     ⚠️ 语言名一律用它自己的语言写在代码里（中文（简体）/ 日本語 / Русский / العربية），
        不引用 strings：不管界面切到哪种语言，用户都得能认出自己要选哪一项。
        副标题才走资源，跟随当前界面语言。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/uiLangContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:text="@string/ui_lang_desc"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp" />
</LinearLayout>
