<?xml version="1.0" encoding="utf-8"?>
<!--
    全部单词记录页（首页「全部 ›」的落点）
    ============================================================
    V2.0 墨标要点：
    · 标题走统一字阶（text_h1），右侧计数用 Text.Label（小号 + 字距）。
    · 列表 paddingHorizontal=0：item_word_card 已改成「行」布局并自带 20dp 内边距，
      这里再缩进一次会让列表比标题缩进更多，文字列对不齐。
    · 空状态与收藏页统一：88dp 虚线环（bg_empty_ring）+ 32dp 图标 + 正文。
      空状态包在 groupEmptyList 里整体显隐，避免「环还在、文案没了」。
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/tvCardTitle"
        style="@style/Text.PageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_horizontal"
        android:layout_marginTop="16dp"
        android:text="@string/cardlist_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvCardCount"
        style="@style/Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_10"
        app:layout_constraintBottom_toBottomOf="@id/tvCardTitle"
        app:layout_constraintStart_toEndOf="@id/tvCardTitle"
        app:layout_constraintTop_toTopOf="@id/tvCardTitle" />

    <TextView
        android:id="@+id/btnSelect"
        style="@style/Text.BodySm"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_min"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="@dimen/touch_min"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/cards_select"
        android:textColor="@color/brand_primary"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/tvCardTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvCardTitle" />

    <ProgressBar
        android:id="@+id/pbSync"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tvCardTitle"
        app:layout_constraintEnd_toStartOf="@id/btnSelect"
        app:layout_constraintTop_toTopOf="@id/tvCardTitle" />

    <!--
        设备切换（v2.8.0）
        ============================================================
        多设备时，本页顶部给一排胶囊：每台设备一个 + 一个「全部」。
        · 不在这里做「合并显示」以外的智能：选哪台就是哪台，选「全部」才是并集；
        · 单设备时整排 GONE —— 一个只有一个选项的切换器只会占地方。
    -->
    <HorizontalScrollView
        android:id="@+id/chipScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/page_horizontal"
        android:paddingEnd="@dimen/page_horizontal"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCardTitle">

        <LinearLayout
            android:id="@+id/chipRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chipScroll">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCards"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_24" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 空状态整体显隐（代码里切 groupEmptyList） -->
    <LinearLayout
        android:id="@+id/groupEmptyList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/swipeRefresh"
        app:layout_constraintEnd_toEndOf="@id/swipeRefresh"
        app:layout_constraintStart_toStartOf="@id/swipeRefresh"
        app:layout_constraintTop_toTopOf="@id/swipeRefresh">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_empty_ring">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_photo_library"
                app:tint="@color/text_tertiary" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvCardEmpty"
            style="@style/Text.BodySm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/cardlist_empty"
            android:textIsSelectable="true" />
    </LinearLayout>

    <!--
        多选态底栏（v2.4.1 新增）
        本页是「全部单词记录」，也就是**拍过的所有照片**——
        批量修复真正的对象在这里，而不是「收藏」页（大多数人不会先收藏再想修图）。
        结构与收藏页那一份完全一致，两处学到同一套手势。
    -->
    <LinearLayout
        android:id="@+id/barSelection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_selection_bar"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_horizontal"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/page_horizontal"
        android:paddingBottom="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSelectionCount"
                style="@style/Text.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="已选 3 张" />

            <TextView
                android:id="@+id/tvSelectionQuota"
                style="@style/Text.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="剩 8 张" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBatchHd"
            style="@style/Widget.ThumbCard.Button.Outline"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height_md"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/ai_style_hd"
            android:textSize="@dimen/text_body_sm" />

        <Button
            android:id="@+id/btnBatchCartoon"
            style="@style/Widget.ThumbCard.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height_md"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/cards_batch_cartoon"
            android:textSize="@dimen/text_body_sm" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
