<?xml version="1.0" encoding="utf-8"?>
<!--
    原图预览页
    ============================================================
    1. **整页是黑的**，不是暖纸底。这是全 App 唯一的例外：
       看图时周围越黑，图的对比度、色彩才越准；
       暖纸底会给照片蒙一层黄，看「这张拍得好不好」就失真了。
    2. 顶栏压一层渐变蒙层（bg_viewer_scrim）而不是实色条：
       照片顶部若是浅色（白墙、天空），实色条会切出一条硬边。
    3. 缩放用自绘的 ZoomImageView：双指缩放 / 双击放大 / 放大后拖动。
       原图只有 160×80，放大必糊——这正是「AI 高清化」存在的理由，
       所以预览页不替用户掩饰像素感，如实呈现。
    4. 底部胶囊只在**已经有 AI 图**时出现（原图 / 高清 / 卡通 三选一）。
       没有 AI 图就没有切换的必要，整行 GONE，不做灰态占位。
    5. 所有内边距用 paddingStart/End：minSdk 23，
       paddingHorizontal 是 API 26+ 的写法，在 6.0/7.0 上会被直接忽略。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viewer_bg"
    android:fitsSystemWindows="true">

    <com.turing.thumbcard.ui.widget.ZoomImageView
        android:id="@+id/ivPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/preview_title" />

    <ProgressBar
        android:id="@+id/pbPreview"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/viewer_progress"
        android:visibility="gone" />

    <!-- ============ 顶栏（渐变蒙层） ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_viewer_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="20dp">

        <ImageView
            android:id="@+id/btnPreviewBack"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/common_back"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:tint="@color/viewer_icon" />

        <TextView
            android:id="@+id/tvPreviewTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/viewer_icon"
            android:textSize="@dimen/text_h2"
            tools:text="iced drink" />

        <!-- 页码：与单词详情页 tvDetailPos 同位置、同格式（detail_pos_fmt）、同字号。
             颜色用 viewer_icon 而不是 viewer_hint —— 顶栏蒙层只有 70% 黑，
             照片若是白墙/天空，54% 白的小字合成后对比度只有约 3.4:1，12sp 不合格。

             importantForAccessibility=no：孤立的一个「4 / 12」对读屏用户没有语义，
             位置信息改由切卡时的 announceForAccessibility 播报一次（见 Activity）。 -->
        <TextView
            android:id="@+id/tvPreviewPos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:fontFamily="sans-serif-medium"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textColor="@color/viewer_icon"
            android:textSize="@dimen/text_caption"
            android:visibility="gone"
            tools:text="3 / 12" />

        <FrameLayout
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min">

            <ImageView
                android:id="@+id/btnPreviewDownload"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_viewer_btn"
                android:contentDescription="@string/preview_save"
                android:padding="8dp"
                android:src="@drawable/ic_download"
                app:tint="@color/viewer_icon" />
        </FrameLayout>
    </LinearLayout>

    <!-- ============ 底部：风格切换 + 操作提示 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal"
        android:paddingEnd="@dimen/page_horizontal"
        android:paddingBottom="24dp">

        <!-- 只有存在 AI 图时才显示；三个胶囊的显隐由代码控制 -->
        <LinearLayout
            android:id="@+id/groupPreviewStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/chipPreviewOriginal"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/preview_style_original"
                android:textColor="@color/viewer_icon"
                android:textSize="@dimen/text_body_sm" />

            <TextView
                android:id="@+id/chipPreviewHd"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/ai_badge_hd"
                android:textColor="@color/viewer_icon"
                android:textSize="@dimen/text_body_sm" />

            <TextView
                android:id="@+id/chipPreviewCartoon"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/ai_badge_cartoon"
                android:textColor="@color/viewer_icon"
                android:textSize="@dimen/text_body_sm" />
        </LinearLayout>

        <!-- AI 美化入口（v2.4.2）
             原本这一页只有「看」和「存」，看完就退出；
             但「这张拍糊了」的念头，恰恰是在原图被放大、发虚的这一刻最强。
             把转化点放在用户刚意识到「不够清楚」的那一秒，比放在详情页更靠前。
             文案与额度由代码按「这张卡有没有 AI 图」决定，不做灰态占位。 -->
        <LinearLayout
            android:id="@+id/barPreviewBeautify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreviewBeautify"
                style="@style/Widget.ThumbCard.Button.Accent"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height_md"
                android:minWidth="150dp"
                android:text="@string/preview_beautify"
                app:icon="@drawable/ic_sparkle" />

            <TextView
                android:id="@+id/tvPreviewQuota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/viewer_hint"
                android:textSize="@dimen/text_caption"
                tools:text="剩 2 张" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPreviewHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/preview_hint"
            android:textColor="@color/viewer_hint"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <!-- ============ 读屏专用切卡按钮 ============
         左右轻扫对读屏用户完全不可用（触摸探索会吃掉手势），所以切换必须另给入口。
         只在 isTouchExplorationEnabled 时可见 —— 普通用户看不到，
         不会永久吃掉照片两侧的宽度（这是"无框看图"的底线）。
         d 类图标在 RTL 下镜像由系统处理，不需要单独出图。 -->
    <ImageView
        android:id="@+id/btnPreviewPrev"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_viewer_nav"
        android:contentDescription="@string/preview_prev"
        android:padding="12dp"
        android:src="@drawable/ic_back"
        android:visibility="gone"
        app:tint="@color/viewer_icon"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/btnPreviewNext"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_viewer_nav"
        android:contentDescription="@string/preview_next"
        android:padding="12dp"
        android:rotation="180"
        android:src="@drawable/ic_back"
        android:visibility="gone"
        app:tint="@color/viewer_icon"
        tools:visibility="visible" />

    <!-- ============ 无图态（这张卡本来就没有图） ============
         与「加载失败」必须长得不一样：失败是可点的重试，这里是不可点的纯文字。
         无底无边正是这条区分的表达 —— 这页唯一可点的东西必须是有填充底色的那一档。 -->
    <TextView
        android:id="@+id/tvPreviewEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="@string/preview_no_image"
        android:textColor="@color/viewer_hint"
        android:textSize="@dimen/text_body_sm"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- ============ 加载失败的居中选择 ============
         失败后这一屏只剩两个有效动作：看下一张、或重试这一张。
         所以占位本身就是按钮（也满足自己定的规则：可点即填充），
         文字用实色 viewer_icon —— hint 是给不可点信息的。
         失败**不再额外弹顶部 pill**：占位已在视觉中心且含文案与动作，
         再弹一条等于同一件事说两遍，还会把注意力从"重试"引开。 -->
    <LinearLayout
        android:id="@+id/btnPreviewRetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_viewer_retry"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_min"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_refresh"
            app:tint="@color/viewer_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/preview_load_failed"
            android:textColor="@color/viewer_icon"
            android:textSize="@dimen/text_body_sm" />
    </LinearLayout>

    <!-- ============ 悬浮提示条（切到头 / 放大态被拦） ============
         锚在**顶部** 72dp（顶栏恒定 8 + 44 + 20，静态值）。
         为什么不贴底部：底部块真实高度是 24(底距) + 16(提示行) + 14(CTA 间距)
         + 44(按钮) + 48(胶囊行) = 146dp，按 88dp 摆会直接压住「AI 美化」按钮。
         贴顶还有个好处 —— 它和页码同处上半屏，一个回答「我在哪一张」、
         一个回答「为什么切不动」，语义上是一组。
         出现即时、只淡出 180ms，不做淡入也不做位移。 -->
    <TextView
        android:id="@+id/tvPreviewBoundary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp"
        android:background="@drawable/bg_viewer_hint"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:textColor="@color/viewer_icon"
        android:textSize="@dimen/text_caption"
        android:visibility="gone"
        tools:text="已经是最后一张了"
        tools:visibility="visible" />

</FrameLayout>
