<?xml version="1.0" encoding="utf-8"?>
<!--
    主容器：3 个 Tab（今天 / 收藏 / 我的）
    ============================================================
    本次调整（V2.0 墨标）：
    · 底部导航与页面同色，改用一条 1dp hairline（@color/divider）切分。
      纸底上用 elevation 会留一圈灰边，看起来像「贴了一张灰卡片」，不符合墨色骨架。
    · Tab 由 4 个减为 3 个：设备管理收敛到「我的 › 我的相机」，
      底部不再长期占用一个位置，主导航只留高频动线。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- hairline：与页面同色底，只靠这条线切分，不靠阴影 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.ThumbCard.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_bar_height"
        android:elevation="0dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:menu="@menu/menu_bottom_nav" />

</LinearLayout>
