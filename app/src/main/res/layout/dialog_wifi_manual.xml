<?xml version="1.0" encoding="utf-8"?>
<!--
    手动输入 WiFi（配网兜底通道）
    ============================================================
    为什么需要：V1.2 的列表式配网依赖固件实现 0x88/0x89，
    未升级的样机固件（V1.0 基线）不回列表，若只剩「刷新重试」
    会让整台设备永久配不上网。此弹窗保留 V1.1 的手输能力，
    仅当列表为空 / 扫描超时时才露出，不干扰新固件的正常流程。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <TextView
        style="@style/Text.Micro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/wifi_manual_ssid_label" />

    <EditText
        android:id="@+id/etSsid"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:hint="@string/wifi_ssid_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLength="32"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_disabled"
        android:textSize="@dimen/text_body" />

    <TextView
        style="@style/Text.Micro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/wifi_manual_pwd_label" />

    <EditText
        android:id="@+id/etPwd"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:hint="@string/wifi_pwd_hint"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:maxLength="64"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_disabled"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/tvManualError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/wifi_ssid_empty"
        android:textColor="@color/warning"
        android:textSize="@dimen/text_body_sm"
        android:visibility="gone" />

</LinearLayout>
