.wrap {
  min-height: 100vh;
  background: var(--paper);
  padding: 0 40rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 顶栏 ===== */
.top {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  margin-top: 12rpx;
}

.back {
  margin-left: -20rpx;
  margin-right: 4rpx;
}

.ico-back {
  width: 48rpx;
  height: 48rpx;
  display: block;
}

/* ===== 步骤指示 ===== */
.steps {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 8rpx 40rpx;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
}

.dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid var(--stroke-strong);
  color: var(--t3);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 当前/已完成：墨底白字（不是荧光——荧光留给药丸和收藏） */
.dot.on {
  background: var(--ink);
  border-color: var(--ink);
  color: var(--on-ink);
}

.slbl {
  margin-top: 10rpx;
  font-size: 22rpx;
  letter-spacing: 0.04em;
  color: var(--t3);
}

.slbl.on {
  color: var(--t1);
  font-weight: 500;
}

.sline {
  flex: 1;
  height: 2rpx;
  background: var(--stroke-strong);
  margin-top: 24rpx;
}

.sline.on {
  background: var(--ink);
}

/* ===== 卡片 ===== */
.card.pad {
  padding: 36rpx 40rpx;
  margin-bottom: 24rpx;
}

.center {
  text-align: center;
  padding: 56rpx 40rpx;
}

/* ===== 准备清单 ===== */
.check-item {
  display: flex;
  align-items: flex-start;
  margin-top: 24rpx;
}

.ck {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--ink);
  margin: 16rpx 20rpx 0 0;
  flex: none;
}

.em {
  color: var(--t1);
  font-weight: 500;
}

/* ===== 按钮 ===== */
.action {
  margin-top: 40rpx;
}

.action-inline {
  margin-top: 40rpx;
}

.gap {
  width: 24rpx;
  flex: none;
}

.link-sm {
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 500;
}

/* ===== 设备行 ===== */
.dev-row {
  display: flex;
  align-items: center;
  padding: 28rpx 40rpx;
  margin-bottom: 16rpx;
}

.dev-ico-box {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--card-alt);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin-right: 24rpx;
}

.dev-ico {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.dev-name {
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 500;
  color: var(--t1);
}

.chev {
  width: 36rpx;
  height: 36rpx;
  flex: none;
  margin-left: 12rpx;
  display: block;
}

/* ===== 信息键值 ===== */
.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.kv2 {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
}

.kv-k {
  font-size: 24rpx;
  color: var(--t3);
}

.kv-v {
  font-size: 26rpx;
  color: var(--t2);
}

.tag-on {
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background: var(--accent);
  color: var(--on-accent);
  font-size: 22rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
}

/* ===== WiFi 列表 ===== */
.ap {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  border-bottom: 1rpx solid var(--divider);
}

.ap:last-of-type {
  border-bottom: 0;
}

.ap-name {
  font-size: 30rpx;
  line-height: 42rpx;
  color: var(--t1);
}

.ap-meta {
  margin-top: 2rpx;
}

.bars {
  display: flex;
  align-items: flex-end;
  height: 40rpx;
  margin-left: 16rpx;
  flex: none;
}

.bar {
  width: 6rpx;
  margin-left: 4rpx;
  border-radius: 3rpx;
  background: var(--stroke-strong);
}

.bar:nth-child(1) { height: 12rpx; }
.bar:nth-child(2) { height: 20rpx; }
.bar:nth-child(3) { height: 28rpx; }
.bar:nth-child(4) { height: 36rpx; }

.bar.on {
  background: var(--t1);
}

.manual-toggle {
  margin-top: 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--ink);
}

/* ===== 输入框 ===== */
.input {
  height: 104rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: var(--card-alt);
  border: 1rpx solid var(--stroke-soft);
  border-radius: 28rpx;
  font-size: 30rpx;
  color: var(--t1);
}

.ph {
  color: var(--t3);
}

/* ===== 状态 / 环形 ===== */
.spin {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 4rpx solid var(--divider);
  border-top-color: var(--ink);
  margin: 0 auto;
  animation: spin 900ms linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.ok-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

/* 对勾用两条边框拼，不用字符（字符在不同机型上基线不稳） */
.ok-mark {
  width: 44rpx;
  height: 22rpx;
  border-left: 5rpx solid #fff;
  border-bottom: 5rpx solid #fff;
  transform: rotate(-45deg) translate(2rpx, -4rpx);
}

.fail-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--danger);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.fail-mark {
  color: #fff;
  font-size: 56rpx;
  font-weight: 500;
  line-height: 1;
}

.state {
  padding: 60rpx 0 0;
  text-align: center;
}

.empty-ico {
  width: 64rpx;
  height: 64rpx;
  display: block;
}

.empty-btn {
  margin: 36rpx auto 0;
  width: 50%;
}

/* ===== 日志（内部调试信息，弱化） ===== */
.logbox {
  margin-top: 32rpx;
  padding: 20rpx 24rpx;
  background: var(--card-alt);
  border-radius: 20rpx;
}

.log {
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--t3);
  font-family: "SF Mono", Menlo, Consolas, monospace;
}

/* ===== 密码弹层 ===== */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(20, 19, 15, 0.42);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: var(--card);
  border-radius: 56rpx 56rpx 0 0;
  padding: 44rpx 40rpx calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-title {
  max-width: 100%;
}

/* ===== 间距工具 ===== */
.mt8 { margin-top: 8rpx; }
.mt10 { margin-top: 10rpx; }
.mt12 { margin-top: 12rpx; }
.mt16 { margin-top: 16rpx; }
.mt20 { margin-top: 20rpx; }
.mt24 { margin-top: 24rpx; }
.mt28 { margin-top: 28rpx; }
.mt32 { margin-top: 32rpx; }

.warn {
  color: var(--warning);
}
